# ─────────────────────────────────────────────────────────────────────
# Stubby env vars. Copy to .dev.vars for local Wrangler dev (NOT .env —
# OpenNext/Workers reads bindings + .dev.vars, not Next's .env files for
# server secrets). In production set secrets via `wrangler secret put`.
# ─────────────────────────────────────────────────────────────────────

# Public base URL of the app (used in generated mock URLs, Stripe redirects).
APP_URL="http://localhost:3000"

# ── Resend (email alerts) ──
# Get a key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Verified sender. Must be on a domain you verified in Resend.
ALERT_FROM_EMAIL="alerts@yourdomain.com"

# ── Stripe (Pro upgrade) ──
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
# Price ID for the ~$7/mo Pro plan (create a recurring Price in Stripe).
STRIPE_PRICE_ID="price_xxxxxxxxxxxxxxxxxxxx"
# Webhook signing secret from `stripe listen` or the Dashboard webhook.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# ── Tier limits (optional overrides; defaults live in src/config/limits.ts) ──
# FREE_MAX_MOCKS="3"
# FREE_MAX_MONITORS="1"
# FREE_MIN_INTERVAL_MINUTES="15"
# FREE_EXPIRY_DAYS="7"
# PRO_MAX_MOCKS="25"
# PRO_MAX_MONITORS="25"
# CHECKS_HISTORY_LIMIT="50"
# CRON_CONCURRENCY="10"
